# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
# Replace with your MongoDB connection string (e.g., MongoDB Atlas)
MONGO_URI=your_mongodb_uri_here

# Authentication
# Generate a secure secret for JWT and Cron
JWT_SECRET=your_jwt_secret_here
CRON_SECRET=your_cron_secret_token_here

# Email Service (SMTP / Brevo / Gmail)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password_or_smtp_key_here
SENDER_EMAIL=no-reply@yourdomain.com

# Redis (for Presence, Load Balancing & Shared State - e.g., Upstash)
REDIS_URL=your_redis_url_here

# Vertex AI Copilot (Groq Llama 3.3 70B SDK)
GROQ_API_KEY=your_groq_api_key_here

# Cloudinary Media Storage (Optimized Image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here


